// transpile all "module*.ts" right next in the same directoris but as *.js
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "./",
    "rootDir": "./",
    "allowJs": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "es.ts",
    "tsc.ignore.ts",
    "scripts/sync-monaco-version.ts",
    "web-component/other-manager",
    "monaco-editor",
    "**/*.e2e.ts",
    "**/*.test.ts"
  ]
}
